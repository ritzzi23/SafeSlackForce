{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace=@safeslackforce/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-WITH-API-TUNNEL.trycloudflare.com/api/:path*" },
    { "source": "/health", "destination": "https://REPLACE-WITH-API-TUNNEL.trycloudflare.com/health" }
  ]
}
