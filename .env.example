HOST=127.0.0.1
PORT=4100
# Frontend dev proxy destination. Use Om's reachable API origin for a shared backend.
# With a shared backend, run only npm run dev:web on this machine.
BACKEND_URL=http://127.0.0.1:4100
# Leave blank to separate fixture and live stores automatically. Never reuse a fixture DB for live mode.
DATABASE_PATH=
# Start with fixture mode to exercise the local backend without external sends or model calls.
INCIDENTOS_MODE=fixture
# Generate locally: openssl rand -hex 24. Ritesh enters this into POST /api/session, never source code.
DASHBOARD_TOKEN=
OPENROUTER_API_KEY=
INCIDENTOS_MODEL=
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_DEMO_CHANNEL_ID=
SLACK_SUPERVISOR_USER_IDS=
SLACK_LEAD_USER_ID=
SLACK_BACKUP_USER_ID=
# Minutes are normal; use 10-20 seconds only for a visibly labelled demo.
FOLLOWUP_SECONDS=300
MODEL_CALL_LIMIT=40
MODEL_MAX_ROUNDS=5
MODEL_BUDGET_USD=1
MODEL_CALL_RESERVE_USD=0.05
EXA_API_KEY=
EXA_ENABLED=false
EXA_CALL_LIMIT=5
FRONTEND_ORIGIN=http://localhost:5173
# URL reachable from participants' browsers; localhost works only on the server laptop.
DASHBOARD_URL=http://localhost:5173
# files:read scope is required for file ingestion. Synthetic images only.
SLACK_FILES_ENABLED=false
# Optional vision shares OpenRouter's existing call and spending allowance.
VISION_ENABLED=false
VISION_MODEL=
