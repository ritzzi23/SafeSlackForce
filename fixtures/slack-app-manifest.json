{
  "display_information": {
    "name": "IncidentOS Demo",
    "description": "Synthetic incident coordination with owned tasks and human handoffs",
    "background_color": "#3730a3"
  },
  "features": { "bot_user": { "display_name": "IncidentOS", "always_online": false } },
  "oauth_config": {
    "scopes": { "bot": ["app_mentions:read", "channels:history", "channels:read", "chat:write", "files:read"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.channels"] },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
